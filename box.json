{
  "$schema": "https://box-project.github.io/box/schema.json",
  "output": "magebean.phar",
  "main": "bin/magebean",
  "chmod": "0755",
  "stub": true,
  "compression": "GZ",

  "directories": [
    "bin",
    "src",
    "resources"
  ],
  "files": [
    "composer.json",
    "LICENSE"
  ],

  "finder": [
    {
      "in": ["vendor"],
      "exclude": ["bin", "tests", "test", "Tests", "Test", "docs", "doc", "Docs", "Doc", ".github"],
      "notName": ["*.phar", "*.phar.*", "phpunit.xml*", ".env*", "README*", "CHANGELOG*", "UPGRADING*"]
    }
  ],

  "exclude-dev-files": true,
  "dump-autoload": true,
  "banner": "Magebean CLI",
  "check-requirements": false
}
