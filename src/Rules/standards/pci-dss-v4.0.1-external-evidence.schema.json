{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magebean.com/schemas/pci-dss-v4.0.1-external-evidence.schema.json",
  "title": "Magebean PCI DSS 4.0.1 external evidence package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "standard", "version", "assessment_id", "collected_at", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "standard": {"const": "PCI DSS"},
    "version": {"const": "4.0.1"},
    "assessment_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "collected_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "method", "source_type", "source_ref", "collected_at", "sha256", "description", "owner", "attestation"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "requirement": {"type": "string", "minLength": 1},
        "method": {"enum": ["examine", "observe", "interview"]},
        "source_type": {"enum": ["document", "configuration_export", "screenshot", "log_export", "ticket", "attestation", "interview_record", "observation_record", "vendor_report", "other"]},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 200},
        "collected_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "description": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "reviewer", "reviewed_at"],
          "properties": {
            "complete": {"const": true},
            "reviewer": {"type": "string", "minLength": 1},
            "reviewed_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    }
  }
}
