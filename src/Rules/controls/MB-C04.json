{
    "control": "MB-C04",
    "title": "HTTPS & TLS Enforcement",
    "rules": [
        {
            "id": "MB-R026",
            "title": "Force HTTPS in admin and storefront",
            "control": "MB-C04",
            "severity": "high",
            "op": "all",
            "checks": [
                {
                    "name": "magento_https_enforced",
                    "args": {
                        "files": [
                            "app/etc/config.php",
                            "app/etc/env.php"
                        ],
                        "timeout_ms": 8000
                    }
                }
            ],
            "messages": {
                "pass": "HTTPS is enforced for both admin and storefront areas.",
                "fail": "HTTPS is not enforced in admin or storefront. Enable secure URLs in env.php."
            }
        },
        {
            "id": "MB-R027",
            "title": "HSTS max-age is at least one year",
            "control": "MB-C04",
            "severity": "medium",
            "op": "any",
            "checks": [
                {
                    "name": "http_has_hsts",
                    "args": {
                        "min_max_age": 31536000,
                        "timeout_ms": 8000
                    }
                },
                {
                    "name": "webserver_hsts_config",
                    "args": {
                        "files": [
                            "nginx.conf",
                            "pub/.htaccess",
                            ".htaccess"
                        ],
                        "min_max_age": 31536000
                    }
                }
            ],
            "messages": {
                "pass": "HSTS is configured with max-age of at least 31536000 seconds.",
                "fail": "HSTS is missing or max-age is shorter than one year. Configure Strict-Transport-Security with max-age of at least 31536000 seconds."
            }
        },
        {
            "id": "MB-R028",
            "title": "TLS protocols >= 1.2",
            "control": "MB-C04",
            "severity": "high",
            "op": "any",
            "checks": [
                {
                    "name": "http_tls_min_version",
                    "args": {
                        "timeout_ms": 8000
                    }
                }
            ],
            "messages": {
                "pass": "TLS is configured to use version 1.2 or higher.",
                "fail": "TLS configuration allows outdated protocols. Restrict to TLS 1.2+."
            }
        },
        {
            "id": "MB-R029",
            "title": "No mixed content (http://) in templates/assets",
            "control": "MB-C04",
            "severity": "medium",
            "op": "all",
            "checks": [
                {
                    "name": "code_no_mixed_content",
                    "args": {
                        "paths": [
                            "app"
                        ],
                        "include_ext": [
                            "phtml",
                            "js",
                            "html",
                            "xml",
                            "css",
                            "less"
                        ],
                        "max_results": 50
                    }
                },
                {
                    "name": "http_no_mixed_content",
                    "args": {
                        "paths": [
                            "/"
                        ],
                        "timeout_ms": 8000
                    }
                }
            ],
            "messages": {
                "pass": "No insecure http:// references detected in templates or assets.",
                "fail": "Mixed content detected. Replace http:// references with https://."
            }
        },
        {
            "id": "MB-R030",
            "title": "Sensitive cookies use Secure, HttpOnly, and SameSite",
            "control": "MB-C04",
            "severity": "high",
            "op": "all",
            "checks": [
                {
                    "name": "magento_cookie_flags_secure",
                    "args": {
                        "files": [
                            "app/etc/config.php",
                            "app/etc/env.php"
                        ],
                        "allowed_samesite": [
                            "lax",
                            "strict"
                        ]
                    }
                },
                {
                    "name": "http_cookie_flags",
                    "args": {
                        "paths": [
                            "/",
                            "/customer/account/login",
                            "/checkout/cart"
                        ],
                        "timeout_ms": 8000
                    }
                }
            ],
            "messages": {
                "pass": "Observed sensitive cookies and Magento cookie configuration use Secure, HttpOnly, and an allowed SameSite policy.",
                "fail": "A sensitive cookie or Magento cookie setting lacks Secure, HttpOnly, or an allowed SameSite policy. Cookie-name prefix requirements require separate evidence."
            }
        },
        {
            "id": "MB-R089",
            "title": "Checkout Content Security Policy enforced",
            "control": "MB-C04",
            "severity": "high",
            "op": "all",
            "checks": [
                {
                    "name": "code_checkout_csp_enforced",
                    "args": {
                        "paths": [
                            "app/code",
                            "app/etc",
                            "app/design",
                            "pub/.htaccess",
                            ".htaccess",
                            "nginx.conf"
                        ],
                        "include_ext": [
                            "xml",
                            "php",
                            "phtml",
                            "html",
                            "conf",
                            "htaccess"
                        ],
                        "required_directives": [
                            "script-src",
                            "connect-src",
                            "frame-src",
                            "form-action"
                        ],
                        "require_reporting": true
                    }
                }
            ],
            "messages": {
                "pass": "Checkout CSP includes payment-page script, connection, frame, form-action, and reporting controls."
            }
        },
        {
            "id": "MB-R096",
            "title": "Security headers baseline enforced",
            "control": "MB-C04",
            "severity": "medium",
            "op": "all",
            "checks": [
                {
                    "name": "code_security_headers_baseline",
                    "args": {
                        "paths": [
                            "app/etc",
                            "app/code",
                            "app/design",
                            "pub/.htaccess",
                            ".htaccess",
                            "nginx.conf"
                        ],
                        "include_ext": [
                            "xml",
                            "php",
                            "phtml",
                            "html",
                            "conf",
                            "htaccess"
                        ]
                    }
                }
            ],
            "messages": {
                "pass": "Baseline browser security headers are configured in application or web server config."
            }
        }
    ]
}
